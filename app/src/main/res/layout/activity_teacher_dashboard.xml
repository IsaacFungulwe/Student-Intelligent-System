<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    tools:context=".TeacherDashboardActivity">

    <TextView
        android:id="@+id/tvTeacherWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Teacher Dashboard"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnRegisterStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Register New Student (Your Grade)"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnMarkAttendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mark Attendance"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnAddResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add/Update Student Results"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnManageSubjects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Subjects for Your Grade"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnPostTeacherAnnouncement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Post Announcement to Your Grade" />

</LinearLayout>