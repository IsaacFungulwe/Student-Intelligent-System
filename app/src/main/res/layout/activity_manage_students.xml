<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section for Adding/Editing Student Details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register/Edit Student"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Student ID (for editing)"
            android:inputType="number" />

        <EditText
            android:id="@+id/editStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Student Name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/editStudentGrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grade"
            android:inputType="number" />

        <Button
            android:id="@+id/btnAddEditStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register/Update Student" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Section for Adding/Updating Results -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Results"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editResultStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Student ID"
            android:inputType="number" />

        <EditText
            android:id="@+id/editResultSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject" />

        <EditText
            android:id="@+id/editResultScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Score"
            android:inputType="number" />

        <Button
            android:id="@+id/btnUpdateResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Score" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Student List and Removal Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Students"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/adminListStudents"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:divider="#CCCCCC"
            android:dividerHeight="1dp" />

    </LinearLayout>
</ScrollView>
