<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    tools:context=".ParentRegisterActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register New Parent"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/editParentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Parent\'s Full Name" />

    <EditText
        android:id="@+id/editParentEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Parent\'s Email"
        android:inputType="textEmailAddress" />

    <EditText
        android:id="@+id/editParentPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Parent\'s Phone"
        android:inputType="phone" />

    <EditText
        android:id="@+id/editParentPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Temporary Password"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/btnRegisterParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Register Parent" />

</LinearLayout>